float hash(vec2 p){
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

vec2 bez(vec2 a, vec2 c, vec2 b, float t){
    float u = 1.0 - t;
    return u*u*a + 2.0*u*t*c + t*t*b;
}

float branch(vec2 p, vec2 a, vec2 c, vec2 b, float w0, float w1){
    const int N = 24;
    float best = 1e5;
    vec2 prev = a;
    for (int i = 1; i <= N; i++){
        vec2 cur = bez(a, c, b, float(i) / float(N));
        vec2 pa = p - prev, ba = cur - prev;
        float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
        float d = length(pa - ba * h);
        float tt = (float(i - 1) + h) / float(N);
        best = min(best, d - (w0 + (w1 - w0) * pow(tt, 0.7)));
        prev = cur;
    }
    return best;
}

float tree(vec2 p){
    p.x += 0.0045 * sin(p.y * 57.0 + 1.3) + 0.0025 * sin(p.y * 131.0 + 0.4);
    p.y += 0.0040 * sin(p.x * 49.0 + 2.1) + 0.0020 * sin(p.x * 117.0);
    float d = 1e5;
    d = min(d, branch(p, vec2(1.6200,-0.0500), vec2(1.4200,0.3000), vec2(1.5000,0.6200), 0.0400, 0.0260));
    d = min(d, branch(p, vec2(1.5000,0.6200), vec2(1.2000,0.8500), vec2(0.7000,0.8600), 0.0260, 0.0100));
    d = min(d, branch(p, vec2(0.7000,0.8600), vec2(0.4500,0.8600), vec2(0.2200,0.9500), 0.0100, 0.0020));
    d = min(d, branch(p, vec2(1.5000,0.6200), vec2(1.7000,0.7200), vec2(1.8500,0.9000), 0.0220, 0.0080));
    d = min(d, branch(p, vec2(1.4800,0.6600), vec2(1.4000,0.8500), vec2(1.3000,1.0500), 0.0160, 0.0040));
    d = min(d, branch(p, vec2(1.0500,0.8000), vec2(0.9500,0.6800), vec2(0.8200,0.6600), 0.0080, 0.0012));
    d = min(d, branch(p, vec2(0.9000,0.8550), vec2(0.8600,0.9500), vec2(0.7800,1.0400), 0.0060, 0.0012));
    d = min(d, branch(p, vec2(0.4500,0.8700), vec2(0.4000,0.8000), vec2(0.3000,0.7800), 0.0040, 0.0010));
    d = min(d, branch(p, vec2(1.6800,0.7200), vec2(1.7500,0.6000), vec2(1.8400,0.5500), 0.0080, 0.0012));
    d = min(d, branch(p, vec2(1.4700,0.4000), vec2(1.6200,0.4200), vec2(1.7000,0.3400), 0.0100, 0.0012));
    d = min(d, branch(p, vec2(1.4000,0.8600), vec2(1.3000,0.8800), vec2(1.2000,0.9800), 0.0060, 0.0012));
    d = min(d, branch(p, vec2(1.4600,0.4800), vec2(1.3000,0.5000), vec2(1.1800,0.4200), 0.0120, 0.0020));
    return d;
}

float rhombus(vec2 q, vec2 b){
    q = abs(q);
    float h = clamp(((b.x - 2.0*q.x)*b.x - (b.y - 2.0*q.y)*b.y) / dot(b, b), -1.0, 1.0);
    float d = length(q - 0.5 * b * vec2(1.0 - h, 1.0 + h));
    return d * sign(q.x*b.y + q.y*b.x - b.x*b.y);
}

vec2 rot(vec2 v, float a){ float c = cos(a), s = sin(a); return vec2(v.x*c + v.y*s, -v.x*s + v.y*c); }

float lattice(vec2 p){
    float a = abs(fract((p.x + p.y) * 85.0) - 0.5);
    float b = abs(fract((p.x - p.y) * 85.0) - 0.5);
    return max(1.0 - smoothstep(0.06, 0.16, a), 1.0 - smoothstep(0.06, 0.16, b));
}

void main(){
    vec2 uv = vUV.st;
    float TAU = 6.28318531;
    float ph = uTime / uPeriod;              // 0..1 across the loop, so every effect repeats cleanly

    // --- subtle slice glitch: a few short bursts per loop ---
    float stepId = floor(ph * 80.0);
    float band   = floor(uv.y * 36.0);
    float r      = hash(vec2(band, stepId));
    float gate   = step(0.955, hash(vec2(stepId, 7.1)));
    float shift  = (r > 0.8 ? (hash(vec2(band, stepId + 3.0)) - 0.5) * 0.03 : 0.0) * gate;
    vec2 guv = uv + vec2(shift, 0.0);

    // --- light chromatic split, slightly stronger during bursts ---
    float ca = 0.0012 + 0.004 * gate;
    vec3 src;
    src.r = texture(sTD2DInputs[0], guv + vec2(ca, 0.0)).r;
    src.g = texture(sTD2DInputs[0], guv).g;
    src.b = texture(sTD2DInputs[0], guv - vec2(ca, 0.0)).b;

    // --- grade: crush to ink, re-tint as cold steel -> silver ---
    float l   = dot(src, vec3(0.2126, 0.7152, 0.0722));
    float m   = max(max(src.r, src.g), src.b);
    float lum = pow(smoothstep(0.04, 0.75, mix(l, m, 0.5)), 1.25) * 0.8;
    vec3 steel = vec3(0.66, 0.69, 0.78);
    vec3 col = mix(steel * lum, vec3(lum), smoothstep(0.5, 1.0, lum));

    // --- cyber cherry tree (aspect-corrected space, y up) ---
    float A  = uRes.x / uRes.y;
    float aa = 1.4 / uRes.y;
    vec2 p = vec2(guv.x * A, guv.y);
    vec3 chrome = vec3(0.80, 0.83, 0.90);
    vec3 pink   = uPetal;
    vec3 core   = mix(uPetal, vec3(1.0), 0.75);
    float sweep = exp(-pow((p.x - (2.25 - fract(ph) * 1.8)) * 3.0, 2.0));   // slow light pass, right to left
    float tear  = 1.0 - 0.6 * gate * step(0.8, r);
    float lat   = lattice(p);

    // chrome mesh branches: dark body, glinting lattice, glowing rim
    float d    = tree(p);
    float fill = 1.0 - smoothstep(-aa, aa, d);
    float rim  = fill * smoothstep(-0.0035, 0.0, d);
    float halo = exp(-max(d, 0.0) * 80.0) * (1.0 - fill);
    float cyl  = 0.35 + 0.65 * sin(clamp(-d / 0.012, 0.0, 1.0) * 1.5708);
    col = col * (1.0 - fill)
        + chrome * (fill * (0.03 + lat * 0.20 * cyl * (0.6 + 0.8 * sweep)) + rim * (0.45 + 0.3 * sweep) + halo * 0.08) * uBloom * tear;

    // neon shards + mesh leaves
    float ds = 1e5, dl = 1e5, fl = 0.0;
    for (int i = 0; i < NSH; i++){
        vec4 s = SHA[i]; vec2 t = SHB[i];
        vec2 q = p - s.xy;
        if (dot(q, q) > (s.w + 0.03) * (s.w + 0.03)) continue;   // skip far shards
        float a2 = s.z + 0.06 * sin(TAU * ph + t.y);              // gentle sway
        float dd = rhombus(rot(q, a2), vec2(s.w, s.w * t.x));
        if (t.x < 0.3){
            if (dd < ds){ ds = dd; fl = 0.75 + 0.25 * sin(TAU * ph * 2.0 + t.y); }
        } else {
            dl = min(dl, dd);
        }
    }
    float sf = 1.0 - smoothstep(-aa, aa, ds);
    float sc = 1.0 - smoothstep(-0.004, -0.0012, ds);
    float sh = exp(-max(ds, 0.0) * 110.0) * (1.0 - sf);
    col = col * (1.0 - sf * 0.9) + (pink * (sf * 0.70 + sh * 0.28) + core * sc * 0.50) * fl * uBloom * tear;

    float lf = 1.0 - smoothstep(-aa, aa, dl);
    float lr = lf * smoothstep(-0.0025, 0.0, dl);
    float lh = exp(-max(dl, 0.0) * 120.0) * (1.0 - lf);
    col = col * (1.0 - lf * 0.85) + pink * (lf * lat * 0.30 + lr * 0.6 + lh * 0.15) * uBloom * tear;

    // drifting shards
    float dp = 1e5;
    for (int i = 0; i < NPET; i++){
        vec4 s = PETALS[i];
        float t = fract(ph * s.z + s.y);
        vec2 c = vec2(s.x - t * 0.40 + 0.03 * sin(TAU * (ph * s.z * 3.0 + s.y)), 1.15 - t * 1.35);
        dp = min(dp, rhombus(rot(p - c, TAU * (ph * s.z * 2.0 + s.y)), vec2(s.w, s.w * 0.22)));
    }
    float pf = 1.0 - smoothstep(-aa, aa, dp);
    col += pink * (pf * 0.45 + exp(-max(dp, 0.0) * 120.0) * (1.0 - pf) * 0.15) * uBloom;

    // --- vignette + hard ink floor ---
    vec2 q = uv - 0.5;
    col *= smoothstep(0.85, 0.25, length(q * vec2(1.0, 1.15)));
    col = max(col - 0.004, 0.0);

    fragColor = TDOutputSwizzle(vec4(col, 1.0));
}
